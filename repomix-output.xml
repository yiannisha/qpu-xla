# branch (destination from regfile)
@qpu
def qpu_branch_abs_reg(asm: Assembly) -> None:
    eidx(rf10, sig=ldunifrf(rf0))
    nop(sig=ldunifrf(rf1))
    shl(rf10, rf10, 2)
    add(rf0, rf0, rf10)
    add(rf1, rf1, rf10)

    mov(tmua, rf0, sig=thrsw)
