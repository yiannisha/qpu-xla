    add(rf11, rf11, 1)
    add(rf11, rf11, 1)
    add(rf11, rf11, 1)
    add(rf11, rf11, 1)  # jump comes here

    mov(tmud, rf11)
    mov(tmua, rf1)
    tmuwt()

    nop(sig=thrsw)
    nop(sig=thrsw)
    nop()
    nop()
    nop(sig=thrsw)
    nop()
    nop()
    nop()


