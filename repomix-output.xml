@qpu
def tmu_config(
    asm: Assembly,
    reg: Register,
    tmp: Register,
    config: list[tuple[int, int, int]],
) -> None:
    mov(reg, -1)

    for per, op, type in config:
        mov(tmp, per)
        shl(tmp, tmp, 4)
        bor(tmp, tmp, op)
        shl(tmp, tmp, 3)
        bor(tmp, tmp, type)

        shl(reg, reg, 8)
        bor(reg, reg, tmp)


