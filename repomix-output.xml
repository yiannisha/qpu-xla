def test_mem() -> None:
    with Driver() as drv:
        n = 4
        a: list[Array[np.uint32]] = []
        off = 42

        for i in range(n):
            a.append(drv.alloc((256 * 1024), dtype=np.uint32))
            a[i][:] = range(i, a[i].shape[0] * n, n)
            a[i][:] += off

