from videocore7.driver import Array, Driver


def rotate_right(n: int, s: int) -> int:
    return ((n << (32 - s)) | (n >> s)) & 0xFFFFFFFF


def count_leading_zeros(n: int) -> int:
    bit = 0x80000000
    count = 0
    while bit != n & bit:
        count += 1
        bit >>= 1
    return count


ops: dict[str | None, Callable[..., Any]] = {
