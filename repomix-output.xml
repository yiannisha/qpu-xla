    add(rf11, rf11, rf1)
    mov(rf2, 4)
    shl(rf2, rf2, rf2)
    mov(tmua, rf11, sig=thrsw).add(rf11, rf11, rf2)
    nop()
    nop()

    nop(sig=ldtmu(rf12))  # require

    mov(tmud, rf12)
    mov(tmua, rf11)

    tmuwt()

    nop(sig=thrsw)
    nop(sig=thrsw)
    nop()
    nop()
    nop(sig=thrsw)
    nop()
    nop()
    nop()


