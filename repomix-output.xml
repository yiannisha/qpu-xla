    def v3d_submit_csd(
        self: Self,
        cfg: tuple[int, int, int, int, int, int, int],
        coef: tuple[int, int, int, int],
        bo_handles: int,
        bo_handle_count: int,
        in_sync: int,
        out_sync: int,
    ) -> None:
        if self._fd is None:
            raise ValueError(f"fd({self._fd}) already closed")
        if len(cfg) != 7:
            raise ValueError(f"cfg has invalid length({len(cfg)})")
        if len(coef) != 4:
