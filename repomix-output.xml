        qpu_rotate_and_mul_to_tmuc,
        qpu_rotate_and_mul_to_tmud,
        qpu_rotate_and_mul_to_tmua,
    ]
    for qpu_code in must_guraded_usages:
        with Driver() as drv:
            with pytest.raises(AssembleError):
                drv.program(qpu_code)
