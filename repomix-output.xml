    add(tmua, rf12, rf1, sig=thrsw)
    nop()
    nop()
    nop(sig=ldtmu(rf12))  # rf12 = src1

    tmu_config(asm, rf16, rf15, [(1, tmu_op, 7)])
    mov(tmuc, rf16)

    mov(tmudref, rf12)

    eidx(rf1)
