@qpu
def qpu_tmu_keeps_memory_consistency(asm: Assembly) -> None:
    nop(sig=ldunifrf(rf10))

    mov(tmuc, -1)
    mov(tmua, rf10, sig=thrsw)
    nop()
    nop()
    nop(sig=ldtmu(rf11))

    add(tmud, rf11, 1)
    mov(tmua, rf10)
    tmuwt()

    mov(tmua, rf10, sig=thrsw)
    nop()
    nop()
    nop(sig=ldtmu(rf11))

    add(tmud, rf11, 1)
    mov(tmua, rf10)
    tmuwt()

    nop(sig=thrsw)
    nop(sig=thrsw)
    nop()
    nop()
    nop(sig=thrsw)
    nop()
    nop()
    nop()


