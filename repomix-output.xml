def _benchmark_callable(
    fn,
    *,
    warmup: int = 1,
    repeat: int = 3,
):
    result = fn()
    for _ in range(warmup):
        result = fn()
    best_sec = float("inf")
    for _ in range(repeat):
        start = getsec()
        result = fn()
        best_sec = min(best_sec, getsec() - start)
    return result, best_sec


