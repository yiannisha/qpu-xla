type BranchConditionLiteral = Literal["always", "a0", "na0", "alla", "anyna", "anya", "allna"]


class BranchCondition:
    _name: BranchConditionLiteral
    _code: int

    def __init__(self: Self, name: BranchConditionLiteral, code: int) -> None:
        self._name = name
        self._code = code

    @property
